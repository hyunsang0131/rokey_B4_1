    }

    function App() {
      const [pageView, setPageView] = useState('HOME');
      const [heroSlide, setHeroSlide] = useState(0);
      const [demoStep, setDemoStep] = useState(0);

      const [searchQuery, setSearchQuery] = useState('');
      const [selectedSize, setSelectedSize] = useState('ALL');
      const [selectedType, setSelectedType] = useState('ALL');
      const [openFilter, setOpenFilter] = useState({ size: true, type: false });
      const [wishlist, setWishlist] = useState(['TANGO']);

      const [selectedBed, setSelectedBed] = useState(null);
      const [modules, setModules] = useState(BED_PRODUCTS[0].defaultPreset);
      const [activeCellId, setActiveCellId] = useState(1);
      const [viewMode, setViewMode] = useState('quarter');
      const [showGuideModal, setShowGuideModal] = useState(false);

      const [stockAlertMessage, setStockAlertMessage] = useState('');

      const [showFactoryDrawer, setShowFactoryDrawer] = useState(false);
      const [currentOrder, setCurrentOrder] = useState(null);
      const [factoryStepIdx, setFactoryStepIdx] = useState(0);

      // 메인 히어로 자동 슬라이드
      useEffect(() => {
        if (pageView !== 'HOME') return;
        const interval = setInterval(() => {
          setDemoStep((prev) => {
            const next = prev + 1;
            if (next % 4 === 0) {
              setHeroSlide(0);
            } else {
              setHeroSlide(1);
            }
            return next;
          });
        }, 3600);
        return () => clearInterval(interval);
      }, [pageView]);

      // 주문 후 공정 단계 진행 시뮬레이션
      useEffect(() => {
        if (!currentOrder || !showFactoryDrawer) return;
        if (factoryStepIdx >= FACTORY_STAGES.length - 1) return;
        const timer = setTimeout(() => {
          setFactoryStepIdx((prev) => prev + 1);
        }, 1800);
        return () => clearTimeout(timer);
      }, [currentOrder, showFactoryDrawer, factoryStepIdx]);

      const currentCell =
        modules.find((m) => m.cell_id === activeCellId) || modules[0];

      const hardCount = modules.filter((m) => m.hardness === '40A').length;
      const softCount = modules.filter((m) => m.hardness === '10A').length;
      const highCount = modules.filter((m) => m.height === 'HIGH').length;

      const handleOpenCustomizer = (bed) => {
        setSelectedBed(bed);
        setModules(bed.defaultPreset.map((m) => ({ ...m })));
        setActiveCellId(1);
        setViewMode('quarter');
      };

      const handleHardnessChange = (newHardness) => {
        if (currentCell.hardness === newHardness) return;

        const nextModules = modules.map((m) => {
          if (m.cell_id !== activeCellId) return m;
          const adjustedHeight = newHardness === '40A' ? 'NORMAL' : m.height;
          return { ...m, hardness: newHardness, height: adjustedHeight };
        });

        const nextHard = nextModules.filter((m) => m.hardness === '40A').length;
        const nextSoft = nextModules.filter((m) => m.hardness === '10A').length;

        if (nextHard > STOCK_LIMITS.HARD || nextSoft > STOCK_LIMITS.SOFT) {
          setStockAlertMessage('재고가 부족합니다 다른 매트릭스를 선택해주세요');
          return;
        }

        setModules(nextModules);
      };

      const handleHeightChange = (newHeight) => {
        if (currentCell.height === newHeight) return;
        if (currentCell.hardness === '40A' && newHeight === 'HIGH') return;

        const nextModules = modules.map((m) =>
          m.cell_id === activeCellId ? { ...m, height: newHeight } : m
        );

        const nextHigh = nextModules.filter((m) => m.height === 'HIGH').length;
        if (nextHigh > STOCK_LIMITS.HIGH) {
          setStockAlertMessage('재고가 부족합니다 다른 매트릭스를 선택해주세요');
          return;
        }

        setModules(nextModules);
      };

      const applyQuickPreset = (presetType) => {
        if (presetType === 'ALL_HARD') {
          setModules(
            modules.map((m) => ({ ...m, hardness: '40A', height: 'NORMAL' }))
          );
        } else if (presetType === 'SHOULDER_SOFT') {
          setModules(
            modules.map((m) => ({
              ...m,
              hardness: m.cell_id === 1 || m.cell_id === 2 ? '10A' : '40A',
              height: m.cell_id === 1 || m.cell_id === 2 ? 'HIGH' : 'NORMAL',
            }))
          );
        } else if (presetType === 'LUMBAR_SOFT') {
          setModules(
            modules.map((m) => ({
              ...m,
              hardness: m.cell_id === 3 || m.cell_id === 4 ? '10A' : '40A',
              height: m.cell_id === 3 || m.cell_id === 4 ? 'HIGH' : 'NORMAL',
            }))
          );
        }
      };

      const handleSubmitOrder = () => {
        const orderedIds = [1, 2, 3, 4, 5, 6];
        const orderedModules = orderedIds.map((id) => {
          const m = modules.find((item) => item.cell_id === id);
          const isSoft = m.hardness === '10A';
