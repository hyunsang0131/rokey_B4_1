    /**
     * 6면이 꽉 찬 솔리드 직육면체(Cuboid) 3D 매트리스 모형 컴포넌트
     */
    function SolidBed3D({
      modules,
      activeCellId,
      onSelectCell,
      interactive = true,
      viewMode = 'quarter',
      compact = false,
    }) {
      const positions = [
        { id: 1, col: 0, row: 0 },
        { id: 2, col: 1, row: 0 },
        { id: 3, col: 0, row: 1 },
        { id: 4, col: 1, row: 1 },
        { id: 5, col: 0, row: 2 },
        { id: 6, col: 1, row: 2 },
      ];

      const getCell = (id) =>
        modules.find((m) => m.cell_id === id) || {
          cell_id: id,
          hardness: '40A',
          height: 'NORMAL',
        };

      const rotateTransform =
        viewMode === 'side'
          ? 'rotateX(76deg) rotateZ(-82deg)'
          : 'rotateX(58deg) rotateZ(-36deg)';

      const scaleClass = compact ? 'scale-[0.82] sm:scale-95' : 'scale-95 sm:scale-105';

      return (
        <div
          className={`relative w-full ${
            compact ? 'h-[320px] sm:h-[360px]' : 'h-[360px] sm:h-[420px]'
          } flex items-center justify-center select-none overflow-hidden`}
          style={{ perspective: '1200px' }}
        >
          <div
            className={`relative transition-transform duration-700 ease-out ${scaleClass}`}
            style={{
              width: '260px',
              height: '360px',
              transformStyle: 'preserve-3d',
              transform: rotateTransform,
            }}
          >
            {/* 바닥 그림자 */}
            <div
              className="absolute inset-0 bg-black/20 blur-xl rounded-md"
              style={{ transform: 'translateZ(-18px) scale(1.06)' }}
            />

            {/* 원목 침대 베이스 프레임 */}
            <div
              className="absolute -inset-3"
              style={{ transformStyle: 'preserve-3d' }}
            >
              <div
                className="absolute inset-0 bg-[#6D5643] border border-[#544030]"
                style={{ transform: 'translateZ(0px)' }}
              />
              <div
                className="absolute left-0 right-0 bottom-0 h-[22px] bg-[#523F2F] origin-bottom"
                style={{ transform: 'rotateX(-90deg)' }}
              />
              <div
                className="absolute top-0 bottom-0 right-0 w-[22px] bg-[#433325] origin-right"
                style={{ transform: 'rotateY(90deg)' }}
              />
              <div
                className="absolute left-0 right-0 top-0 h-[86px] bg-[#5C4736] border border-[#463527] origin-top flex items-center justify-center"
                style={{ transform: 'rotateX(-90deg) translateY(-86px)' }}
              >
                <span className="text-[10px] tracking-[0.25em] text-white/40 uppercase">
                  HEADBOARD
                </span>
              </div>
            </div>

            {/* 6개 직육면체 쿠션 블록 */}
            <div
              className="relative w-full h-full grid grid-cols-2 grid-rows-3 gap-2 p-1"
              style={{ transformStyle: 'preserve-3d' }}
            >
              {positions.map(({ id }) => {
                const cell = getCell(id);
                const isSoft = cell.hardness === '10A';
                const isHigh = cell.height === 'HIGH';
                const isSelected = interactive && activeCellId === id;

                const blockHeight = isHigh ? 64 : 38;
                const topColor = isSoft ? '#F4ECE0' : '#53687A';
                const frontColor = isSoft ? '#DFD3C0' : '#3E5060';
                const sideColor = isSoft ? '#C7B8A1' : '#2D3C49';
                const borderColor = isSelected
                  ? '#1A1A1A'
                  : isSoft
                  ? '#C9BBA6'
                  : '#364654';

                return (
                  <div
                    key={id}
                    onClick={() => interactive && onSelectCell && onSelectCell(id)}
                    className={`relative w-full h-full transition-all duration-500 ${
                      interactive ? 'cursor-pointer' : ''
                    }`}
                    style={{ transformStyle: 'preserve-3d' }}
                  >
                    {/* 윗면 */}
                    <div
                      className="absolute inset-0 flex flex-col items-center justify-center transition-all duration-500"
                      style={{
                        backgroundColor: topColor,
                        border: `${isSelected ? '2.5px' : '1px'} solid ${borderColor}`,
                        transform: `translateZ(${blockHeight}px)`,
                        boxShadow: isSelected
                          ? '0 0 0 2px rgba(255,255,255,0.8) inset'
                          : 'none',
                      }}
                    >
                      <span
                        className={`text-[13px] font-bold tracking-tight ${
                          isSoft ? 'text-[#2C2620]' : 'text-white'
                        }`}
                      >
                        #{id}
                      </span>
                      <span
                        className={`text-[10px] font-medium mt-0.5 ${
                          isSoft ? 'text-[#6E6254]' : 'text-white/80'
                        }`}
                      >
                        {isSoft ? '6.8N' : '12.0N'}
                      </span>
                      {isHigh && (
                        <span className="mt-1 px-1.5 py-[1px] bg-[#1A1A1A] text-white text-[8px] tracking-wider uppercase">
                          HIGH
                        </span>
                      )}
                    </div>

                    {/* 앞면 */}
                    <div
                      className="absolute left-0 right-0 bottom-0 origin-bottom transition-all duration-500"
                      style={{
                        height: `${blockHeight}px`,
                        backgroundColor: frontColor,
                        borderLeft: `1px solid ${borderColor}`,
                        borderRight: `1px solid ${borderColor}`,
                        borderBottom: `1px solid ${borderColor}`,
                        transform: 'rotateX(-90deg)',
                      }}
                    />

                    {/* 우측면 */}
                    <div
                      className="absolute top-0 bottom-0 right-0 origin-right transition-all duration-500"
                      style={{
                        width: `${blockHeight}px`,
                        backgroundColor: sideColor,
                        borderTop: `1px solid ${borderColor}`,
                        borderBottom: `1px solid ${borderColor}`,
                        borderRight: `1px solid ${borderColor}`,
                        transform: 'rotateY(90deg)',
                      }}
                    />

                    {/* 좌측면 */}
                    <div
                      className="absolute top-0 bottom-0 left-0 origin-left transition-all duration-500"
                      style={{
                        width: `${blockHeight}px`,
                        backgroundColor: sideColor,
                        transform: 'rotateY(-90deg)',
                      }}
                    />

                    {/* 뒷면 */}
                    <div
                      className="absolute left-0 right-0 top-0 origin-top transition-all duration-500"
                      style={{
                        height: `${blockHeight}px`,
                        backgroundColor: frontColor,
                        transform: 'rotateX(90deg)',
                      }}
                    />
                  </div>
                );
              })}
            </div>
          </div>

          {/* 시점 범례 */}
          <div className="absolute bottom-3 left-4 flex items-center gap-4 text-[11px] text-[#555555] bg-white/85 backdrop-blur-sm px-3 py-1.5 border border-[#E5E5E5]">
            <span className="flex items-center gap-1.5">
              <span className="w-2.5 h-2.5 bg-[#53687A] inline-block" />
              탄탄함 (12.0N)
            </span>
            <span className="flex items-center gap-1.5">
              <span className="w-2.5 h-2.5 bg-[#F4ECE0] border border-[#C9BBA6] inline-block" />
              부드러움 (6.8N)
            </span>
          </div>
        </div>
