                    />

                    <div className="mt-4 pt-4 border-t border-[#E2E0D8] grid grid-cols-3 gap-2 text-center text-[12px]">
                      <div className="bg-white py-2 px-2 border border-[#E5E5E5]">
                        <span className="text-[#767676] block text-[11px]">
                          딱딱함 (12.0N)
                        </span>
                        <strong className="text-[#1A1A1A]">
                          {hardCount} / {STOCK_LIMITS.HARD}개 사용
                        </strong>
                      </div>
                      <div className="bg-white py-2 px-2 border border-[#E5E5E5]">
                        <span className="text-[#767676] block text-[11px]">
                          부드러움 (6.8N)
                        </span>
                        <strong className="text-[#1A1A1A]">
                          {softCount} / {STOCK_LIMITS.SOFT}개 사용
                        </strong>
                      </div>
                      <div className="bg-white py-2 px-2 border border-[#E5E5E5]">
                        <span className="text-[#767676] block text-[11px]">
                          높은 지지
                        </span>
                        <strong className="text-[#1A1A1A]">
                          {highCount} / {STOCK_LIMITS.HIGH}개 사용
                        </strong>
                      </div>
                    </div>
                  </div>

                  {/* 우측 옵션 패널 */}
                  <div className="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between space-y-6">
                    <div className="space-y-6">
                      <div>
                        <label className="block text-[12px] font-semibold text-[#767676] mb-2">
                          빠른 추천 세팅
                        </label>
                        <div className="grid grid-cols-3 gap-2">
                          <button
                            onClick={() => applyQuickPreset('ALL_HARD')}
                            className="py-2 px-2 border border-[#DDDDDD] text-[12px] hover:border-[#1A1A1A] transition-colors"
                          >
                            전신 탄탄함
                          </button>
                          <button
                            onClick={() => applyQuickPreset('SHOULDER_SOFT')}
                            className="py-2 px-2 border border-[#DDDDDD] text-[12px] hover:border-[#1A1A1A] transition-colors"
                          >
                            어깨 릴리프
                          </button>
                          <button
                            onClick={() => applyQuickPreset('LUMBAR_SOFT')}
                            className="py-2 px-2 border border-[#DDDDDD] text-[12px] hover:border-[#1A1A1A] transition-colors"
                          >
                            허리 릴리프
                          </button>
                        </div>
                      </div>

                      <div>
                        <div className="flex items-center justify-between mb-2">
                          <span className="text-[12px] font-semibold text-[#767676]">
                            매트리스 위치 선택
                          </span>
                          <span className="text-[12px] font-bold text-[#1A1A1A]">
                            #{currentCell.cell_id} ({currentCell.label})
                          </span>
                        </div>
                        <div className="grid grid-cols-2 gap-2">
                          {[1, 2, 3, 4, 5, 6].map((id) => {
                            const item = modules.find((m) => m.cell_id === id);
                            const isAct = activeCellId === id;
                            return (
                              <button
                                key={id}
                                onClick={() => setActiveCellId(id)}
                                className={`py-2.5 px-3 border text-left flex items-center justify-between transition-colors ${
                                  isAct
                                    ? 'border-[#1A1A1A] bg-[#1A1A1A] text-white'
                                    : 'border-[#E0E0E0] bg-white text-[#1A1A1A] hover:border-[#999999]'
                                }`}
                              >
                                <span className="text-[12px] font-semibold">
                                  #{id} {item.label}
                                </span>
                                <span
                                  className={`text-[11px] ${
                                    isAct ? 'text-white/80' : 'text-[#767676]'
                                  }`}
                                >
                                  {item.hardness === '10A' ? '6.8N' : '12.0N'} ·{' '}
                                  {item.height === 'HIGH' ? '높음' : '기본'}
                                </span>
                              </button>
                            );
                          })}
                        </div>
                      </div>

                      <div>
                        <label className="block text-[12px] font-semibold text-[#767676] mb-2">
                          쿠션 강성 선택
                        </label>
                        <div className="grid grid-cols-2 gap-2.5">
                          <button
                            onClick={() => handleHardnessChange('40A')}
                            className={`p-3.5 border text-left transition-all ${
                              currentCell.hardness === '40A'
                                ? 'border-[#1A1A1A] bg-[#F7F8FA]'
                                : 'border-[#E0E0E0] hover:border-[#999999]'
                            }`}
                          >
                            <div className="flex items-center gap-2">
                              <span className="w-3 h-3 bg-[#53687A] inline-block" />
                              <span className="text-[14px] font-bold text-[#1A1A1A]">
                                딱딱함
                              </span>
                            </div>
                            <span className="block text-[12px] text-[#666666] mt-1">
                              강성 12.0N · 고밀도 지지
                            </span>
                          </button>

                          <button
                            onClick={() => handleHardnessChange('10A')}
                            className={`p-3.5 border text-left transition-all ${
                              currentCell.hardness === '10A'
                                ? 'border-[#1A1A1A] bg-[#FAF8F4]'
                                : 'border-[#E0E0E0] hover:border-[#999999]'
                            }`}
                          >
                            <div className="flex items-center gap-2">
                              <span className="w-3 h-3 bg-[#F4ECE0] border border-[#C9BBA6] inline-block" />
                              <span className="text-[14px] font-bold text-[#1A1A1A]">
                                부드러움
                              </span>
                            </div>
                            <span className="block text-[12px] text-[#666666] mt-1">
                              강성 6.8N · 소프트 쿠션
                            </span>
                          </button>
                        </div>
                      </div>

                      <div>
                        <label className="block text-[12px] font-semibold text-[#767676] mb-2">
                          쿠션 높낮이 선택
                        </label>
                        <div className="grid grid-cols-2 gap-2.5">
                          <button
                            onClick={() => handleHeightChange('NORMAL')}
                            className={`p-3 border text-center text-[13px] font-medium transition-colors ${
                              currentCell.height === 'NORMAL'
                                ? 'border-[#1A1A1A] bg-[#1A1A1A] text-white'
                                : 'border-[#E0E0E0] text-[#1A1A1A] hover:border-[#999999]'
                            }`}
                          >
                            기본 높이
                          </button>

                          <button
                            onClick={() => handleHeightChange('HIGH')}
                            disabled={currentCell.hardness === '40A'}
                            className={`p-3 border text-center text-[13px] font-medium transition-colors ${
                              currentCell.hardness === '40A'
                                ? 'border-[#EAEAEA] bg-[#F5F5F5] text-[#AAAAAA] cursor-not-allowed'
                                : currentCell.height === 'HIGH'
                                ? 'border-[#1A1A1A] bg-[#1A1A1A] text-white'
                                : 'border-[#E0E0E0] text-[#1A1A1A] hover:border-[#999999]'
                            }`}
                          >
                            {currentCell.hardness === '40A'
                              ? '높은 지지(재고소진)'
                              : '높은 지지'}
                          </button>
                        </div>
                      </div>
                    </div>

                    <div className="pt-4 border-t border-[#E5E5E5] flex items-center gap-3">
                      <button
                        onClick={() => handleOpenCustomizer(selectedBed)}
                        className="px-4 py-3.5 border border-[#CCCCCC] text-[#555555] hover:text-[#1A1A1A] hover:border-[#1A1A1A] text-[13px]"
                        title="초기화"
                      >
                        ↺
                      </button>
                      <button
                        onClick={handleSubmitOrder}
                        className="flex-1 py-3.5 bg-[#1A1A1A] text-white text-[14px] font-semibold tracking-wide hover:bg-[#333333] transition-colors"
                      >
                        나만의 침대 주문하기
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* ================= 5. 재고 부족 알림 팝업 ================= */}
          {stockAlertMessage && (
            <div className="fixed inset-0 z-[60] bg-black/50 flex items-center justify-center p-4">
              <div className="bg-white w-full max-w-[440px] border border-[#1A1A1A] p-7 sm:p-8 shadow-2xl text-center">
                <div className="w-11 h-11 mx-auto mb-4 rounded-full bg-[#F5F5F5] flex items-center justify-center text-[#1A1A1A] font-bold">
                  !
                </div>
                <h3 className="text-[17px] sm:text-[18px] font-bold text-[#1A1A1A] leading-snug break-keep">
                  {stockAlertMessage}
                </h3>
                <p className="text-[13px] text-[#666666] mt-2.5 leading-relaxed break-keep">
                  현재 보유 수량은 딱딱함(12.0N) 최대 6개, 부드러움(6.8N) 최대 2개, 높은 지지 최대 2개입니다.
                </p>
                <button
                  onClick={() => setStockAlertMessage('')}
                  className="mt-6 w-full py-3 bg-[#1A1A1A] text-white text-[13px] font-semibold hover:bg-[#333333] transition-colors"
                >
                  확인
                </button>
              </div>
            </div>
          )}

          {/* ================= 6. 쿠션 스펙 가이드 모달 ================= */}
          {showGuideModal && (
            <div className="fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
              <div className="bg-white w-full max-w-[560px] border border-[#E5E5E5] p-7 sm:p-9 shadow-2xl">
                <div className="flex items-center justify-between pb-4 border-b border-[#E5E5E5]">
                  <h3 className="text-[18px] font-bold text-[#1A1A1A]">
                    팀원매트릭스 6존 쿠션 가이드
                  </h3>
                  <button
                    onClick={() => setShowGuideModal(false)}
                    className="text-[#555555] hover:text-[#1A1A1A]"
                  >
                    ✕
                  </button>
                </div>
                <div className="py-5 space-y-4 text-[13px] text-[#444444] leading-relaxed">
                  <div className="p-4 bg-[#F8F8F8] border border-[#EAEAEA]">
                    <strong className="text-[#1A1A1A] block mb-1">
                      1. 딱딱함 (12.0N / Firm)
                    </strong>
                    척추와 골반을 단단하게 받쳐주어 허리 처짐을 방지하는 고밀도 지지 모듈입니다. (보유 6개)
                  </div>
                  <div className="p-4 bg-[#FAF8F4] border border-[#EAE6DF]">
                    <strong className="text-[#1A1A1A] block mb-1">
                      2. 부드러움 (6.8N / Soft)
                    </strong>
                    어깨나 특정 부위의 체압을 부드럽게 감싸 안아주는 저경도 쿠션 모듈입니다. (보유 2개)
                  </div>
                  <div className="p-4 bg-[#F8F8F8] border border-[#EAEAEA]">
                    <strong className="text-[#1A1A1A] block mb-1">
                      3. 높낮이 조절 (기본 높이 / 높은 지지)
                    </strong>
                    부위별 지지 높이를 다르게 설계하여 인체 굴곡에 맞춘 맞춤형 수면 자세를 완성합니다. (높은 지지 2개)
                  </div>
                </div>
                <button
                  onClick={() => setShowGuideModal(false)}
                  className="w-full py-3 bg-[#1A1A1A] text-white text-[13px] font-medium"
                >
                  닫기
                </button>
              </div>
            </div>
          )}

          {/* ================= 7. 주문서 드로어 ================= */}
          {showFactoryDrawer && (
            <div className="fixed inset-0 z-50 bg-black/45 flex justify-end">
              <div className="bg-white w-full max-w-[480px] h-full flex flex-col justify-between shadow-2xl overflow-y-auto">
                <div className="p-6 sm:p-8">
                  <div className="flex items-center justify-between pb-5 border-b border-[#E5E5E5]">
                    <div>
                      <span className="text-[11px] tracking-[0.15em] text-[#767676] uppercase">
                        ORDER SHEET
                      </span>
                      <h3 className="text-[18px] font-bold text-[#1A1A1A] mt-0.5">
                        주문서
                      </h3>
                    </div>
                    <button
                      onClick={() => setShowFactoryDrawer(false)}
                      className="text-[#555555] hover:text-[#1A1A1A]"
                    >
                      ✕
                    </button>
                  </div>

                  {!currentOrder ? (
                    <div className="py-20 text-center space-y-4">
                      <p className="text-[14px] text-[#666666]">
                        접수된 맞춤 침대 주문서가 없습니다.
                      </p>
                      <button
                        onClick={() => {
                          setShowFactoryDrawer(false);
                          handleOpenCustomizer(BED_PRODUCTS[0]);
                        }}
                        className="px-5 py-2.5 bg-[#1A1A1A] text-white text-[12px] font-medium"
                      >
                        나만의 침대 만들기
                      </button>
                    </div>
                  ) : (
                    <div className="py-6 space-y-6">
                      <div className="bg-[#F8F8F8] p-4 border border-[#E5E5E5] space-y-1.5 text-[13px]">
                        <div className="flex justify-between">
                          <span className="text-[#767676]">주문번호</span>
                          <strong className="text-[#1A1A1A]">
                            {currentOrder.order_id}
                          </strong>
                        </div>
                        <div className="flex justify-between">
                          <span className="text-[#767676]">모델 / 규격</span>
                          <span className="text-[#1A1A1A]">
                            {currentOrder.bed_model} ({currentOrder.size})
                          </span>
                        </div>
                        <div className="flex justify-between">
                          <span className="text-[#767676]">배열 순서</span>
                          <span className="text-[#1A1A1A]">
                            [1, 2], [3, 4], [5, 6]
                          </span>
                        </div>
                      </div>

                      <div>
                        <h4 className="text-[12px] font-semibold text-[#767676] mb-2">
                          구역별 주문 사양
                        </h4>
                        <div className="grid grid-cols-2 gap-2">
                          {currentOrder.modules.map((m) => (
                            <div
                              key={m.cell_id}
                              className="p-3 border border-[#E5E5E5] text-[12px] flex items-center justify-between"
                            >
                              <div>
                                <strong className="text-[#1A1A1A]">
                                  #{m.cell_id} {m.position_label}
                                </strong>
                                <span className="block text-[#666666] mt-0.5">
                                  {m.stiffness_N === 6.8 ? '부드러움' : '딱딱함'} (
                                  {m.stiffness_N}N)
                                </span>
                              </div>
                              <span className="px-2 py-0.5 bg-[#F3F3F3] text-[#1A1A1A] text-[11px] font-medium">
                                {m.height === 'HIGH' ? '높은 지지' : '기본 높이'}
                              </span>
                            </div>
                          ))}
                        </div>
                      </div>

                      <div>
                        <h4 className="text-[12px] font-semibold text-[#767676] mb-2">
                          제작 진행 현황
                        </h4>
                        <div className="border border-[#E5E5E5] divide-y divide-[#E5E5E5]">
                          {FACTORY_STAGES.map((stage, idx) => {
                            const isDone = idx < factoryStepIdx;
                            const isActive = idx === factoryStepIdx;
                            return (
                              <div
                                key={stage.code}
                                className={`px-4 py-3 flex items-center justify-between text-[13px] ${
                                  isActive
                                    ? 'bg-[#F8F8F8] font-bold text-[#1A1A1A]'
                                    : 'text-[#666666]'
                                }`}
                              >
                                <div className="flex items-center gap-3">
                                  <span className="text-[11px] text-[#999999] font-mono">
                                    {stage.code}
                                  </span>
                                  <span>{stage.name}</span>
                                </div>
                                {isDone ? (
                                  <span className="text-[#1A1A1A] font-bold">✓</span>
                                ) : isActive ? (
                                  <span className="text-[11px] text-[#1A1A1A]">
                                    진행중
                                  </span>
                                ) : (
                                  <span className="text-[11px] text-[#CCCCCC]">
                                    대기
                                  </span>
                                )}
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    </div>
                  )}
                </div>

                <div className="p-6 border-t border-[#E5E5E5]">
                  <button
                    onClick={() => setShowFactoryDrawer(false)}
                    className="w-full py-3 border border-[#1A1A1A] text-[13px] font-medium text-[#1A1A1A] hover:bg-[#1A1A1A] hover:text-white transition-colors"
                  >
                    닫기
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* 푸터 */}
          <footer className="border-t border-[#E5E5E5] bg-[#FAFAFA] mt-20">
            <div className="max-w-[1360px] mx-auto px-6 lg:px-12 py-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 text-[12px] text-[#767676]">
              <div>
                <p className="text-[15px] font-bold tracking-[0.2em] text-[#1A1A1A]">
                  TEAMWON
                </p>
                <p className="mt-2">
                  팀원매트릭스 · 6-Zone Bespoke Modular Mattress System
                </p>
              </div>
              <p>© 2026 TEAMWON MATTRESS. All rights reserved.</p>
            </div>
          </footer>

          {/* TOP 플로팅 버튼 */}
          <button
            onClick={() => window.scrollTo({ top: 0, behavior: 'smooth' })}
            aria-label="맨 위로 이동"
            className="fixed bottom-6 right-6 z-30 w-11 h-11 bg-white border border-[#CCCCCC] shadow-md flex items-center justify-center text-[#1A1A1A] hover:bg-[#1A1A1A] hover:text-white transition-colors text-xs font-bold"
          >
            ↑
          </button>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
